+    # ── Download directory ────────────────────────────────────────────────
+
+    def download_dir(self) -> Path:
+        """Resolved SLSK_DOWNLOAD_DIR, created if missing."""
+        dl_dir = Path(os.environ.get("SLSK_DOWNLOAD_DIR", "./downloads"))
+        dl_dir.mkdir(parents=True, exist_ok=True)
+        return dl_dir.resolve()
+
+    def resolve_download_path(self, rel: str = "") -> Path:
+        """Resolve a relative subfolder inside the download dir.
+
+        The directory is not created. Raises ValueError on absolute paths and
+        on anything that escapes the download dir via '..' or a symlink.
+        """
+        base = self.download_dir()
+        candidate = (base / (rel or "")).resolve()
+        if candidate != base and not candidate.is_relative_to(base):
+            raise ValueError(
+                f"path escapes the download dir: {rel!r}"
+            )
+        return candidate
+
+    def list_download_dir(
+        self, rel: str = "", recursive: bool = False, max_entries: int = 200
+    ) -> Dict[str, Any]:
+        """List the download dir tree. Pure filesystem, no connection needed.
+
+        Returns entries with name, type, size and modified. Names are relative
+        to the download dir, so they can be passed straight back as dest_dir.
+        """
+        base = self.download_dir()
+        target = self.resolve_download_path(rel)
+        max_entries = max(1, min(max_entries, 2000))
+
+        if not target.is_dir():
+            return {
+                "download_dir": str(base),
+                "path": rel,
+                "exists": False,
+                "count": 0,
+                "entries": [],
+                "truncated": False,
+                "note": (
+                    "No such subfolder. Call with path='' to see the root, or "
+                    "with recursive=True to see the whole tree."
+                ),
+            }
+
+        entries: List[Dict[str, Any]] = []
+        truncated = False
+        walker = target.rglob("*") if recursive else target.iterdir()
+        for item in sorted(walker, key=lambda p: str(p).lower()):
+            if len(entries) >= max_entries:
+                truncated = True
+                break
+            try:
+                st = item.stat()
+                is_dir = item.is_dir()
+            except OSError:
+                continue
+            entries.append({
+                "name": str(item.relative_to(base)),
+                "type": "dir" if is_dir else "file",
+                "size": None if is_dir else st.st_size,
+                "modified": int(st.st_mtime),
+            })
+
+        return {
+            "download_dir": str(base),
+            "path": str(target.relative_to(base)) if target != base else "",
+            "exists": True,
+            "count": len(entries),
+            "entries": entries,
+            "truncated": truncated,
+        }
+
