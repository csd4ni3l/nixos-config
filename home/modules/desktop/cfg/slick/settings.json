        ".sk-client-theme--dark .c-reaction--reacted,.sk-client-theme--dark .c-reaction--reacted:hover{background-color:rgba(136,192,208,0.18) !important;box-shadow:0 0 0 1px #88c0d0 !important;}",
        ".sk-client-theme--dark .c-reaction--reacted .c-reaction__count{color:#88c0d0 !important;}",
        ".p-message_input__input_container_unstyled,.c-wysiwyg_container--theme_dark{background-color:#232833 !important;border:1px solid #3a4350 !important;}",
        ".c-wysiwyg_container__formatting{background:#232833 !important;}",
        ".p-context_bar_v2,[data-qa=context_bar]{background:#232833 !important;border:1px solid #3a4350 !important;}",
        ".p-context_bar_v2__content,.p-context_bar_v2__icon{color:#c6cdd8 !important;}",
        "[role=menu],[role=dialog],[role=listbox],.c-menu,.p-ia4_floating_window,.c-popover__content{background-color:#232833 !important;border:1px solid #343c4b !important;}",
        ".c-message_kit__background--hovered:not(.c-message_kit__background--highlight):not(.c-message_kit__background--editing):not(.c-message_kit__background--huddle):not(.c-message_kit__background--deleting){background:#2e3644 !important;}",
        ".c-message:hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred),.c-message--hover:not(.c-message--highlight):not(.c-message--standalone):not(.c-message--pinned):not(.c-message--ephemeral):not(.c-message--custom_response):not(.c-message--starred){background:#2e3644 !important;}",
