        "::selection{background:rgba(136,192,208,0.3);}",
        ".c-button--primary,.c-icon_button--primary,.c-icon_button--primary:link,[class*=sendButtonActive__],[class*=joinButton__],[class*=primaryCtaPrimary__]{background-color:#88c0d0 !important;color:#1a1f27 !important;}",
        ".c-button--primary:hover,.c-icon_button--primary:hover{background-color:#94c9d6 !important;}",
        "[data-qa=huddle_toolbar__leave_button]{background-color:#bf616a !important;color:#1a1f27 !important;}",
        "[data-qa=huddle_toolbar__leave_button]:hover{background-color:#ce737c !important;}",
        ".c-mrkdwn__code,.c-texty_input code,.c-wysiwyg_container--theme_dark code,.c-pillow_file__post__content code{color:#d08770 !important;}",
